# Copy to .env and fill in. Never commit .env.  Check it with:  npm run check
NODE_ENV=production
PORT=3000
SITE_URL=https://bookmyshow.world
# Set to 1 when behind Nginx, Cloudflare, Render, Railway etc. (correct visitor IPs for rate limits)
TRUST_PROXY=1
# Where bookings/queries are stored. Must be a persistent disk or volume. Default: ./data
# DATA_DIR=/var/lib/bookmyshow-world

# Admin dashboard (/admin/) password: at least 12 characters
ADMIN_PASSWORD=change-me-to-something-long

# Stripe (https://dashboard.stripe.com/apikeys). Leave blank for TEST MODE.
# Use sk_test_... first, switch to sk_live_... after your Stripe account is activated for AED.
STRIPE_SECRET_KEY=
# Developers > Webhooks > Add endpoint: https://<your-domain>/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Gmail sending (contact form alerts + e-tickets + booking alerts)
# SMTP_PASS = a Google App Password (16 letters; spaces are fine), NOT the normal Gmail password.
SMTP_USER=connect.technow@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
# 465 = TLS (default). If your host blocks 465, use 587 (STARTTLS).
SMTP_PORT=465
# Inbox that receives every query and new-booking alert
MAIL_TO=connect.technow@gmail.com
MAIL_FROM_NAME=Bookmyshow.world

# Signs the QR code on every e-ticket. Set a long random value and never change it after launch
# (changing it makes existing tickets fail verification). Blank = auto-generated in DATA_DIR/.ticket-secret
#   generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=

# Time zone for "bookings per day" on the dashboard
REPORT_TIMEZONE=Asia/Kolkata

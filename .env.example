# Copy to .env (or add each line in Vercel → Settings → Environment Variables). Never commit .env.
# Check your settings with:  npm run check
NODE_ENV=production
SITE_URL=https://bookmyshow.world
# Set to 1 behind Nginx, Cloudflare, Render, Railway (automatic on Vercel)
TRUST_PROXY=1

# Admin dashboard (/admin/) password: at least 12 characters
ADMIN_PASSWORD=change-me-to-something-long

# ---------- Ziina payments (AED) ----------
# API key from https://ziina.com/business/connect  (needs write_payment_intents and write_webhooks)
# Leave blank for TEST MODE (simulated payments on the site, nothing charged).
ZIINA_API_KEY=
# true = Ziina test payments (any card works, nothing is charged). Set to false to take real money.
ZIINA_TEST_MODE=true
# Any long random text. After deploying, run:  npm run ziina:webhook
ZIINA_WEBHOOK_SECRET=

# ---------- Storage ----------
# On Vercel you MUST use Upstash Redis (Vercel → Storage → Upstash Redis fills these in for you).
# On a normal server leave these blank: data is kept in DATA_DIR/db.json on a persistent disk.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DATA_DIR=/var/lib/bookmyshow-world

# ---------- Gmail (contact form alerts + e-tickets + booking alerts) ----------
# SMTP_PASS = a Google App Password (16 letters; spaces are fine), NOT the normal Gmail password.
SMTP_USER=connect.technow@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
# 465 = TLS (default). If your host blocks 465, use 587 (STARTTLS).
SMTP_PORT=465
# Inbox that receives every query and new-booking alert
MAIL_TO=connect.technow@gmail.com
MAIL_FROM_NAME=Bookmyshow.world

# Signs the QR code on every e-ticket. Set a long random value and never change it after launch.
#   generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=

# Time zone for "bookings per day" on the dashboard
REPORT_TIMEZONE=Asia/Kolkata
